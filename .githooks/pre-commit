#!/bin/sh
# imok 1v1: refuse the commit if any script in index.html (or sw.js) has a syntax error.
# Turned on once per clone with: git config core.hooksPath .githooks
if ! command -v node >/dev/null 2>&1; then echo "pre-commit: node not found, skipping the syntax check" >&2; exit 0; fi
# keep MODEL_STAMP (the menu-picture fingerprint of models/ and chars/) in step with what is being committed
R="$(git rev-parse --show-toplevel)"; if node "$R/tools/check.js" --stamp 2>/dev/null | grep -q "MODEL_STAMP updated"; then git add "$R/index.html"; fi
node "$(git rev-parse --show-toplevel)/tools/check.js" >/dev/null || { node "$(git rev-parse --show-toplevel)/tools/check.js"; echo "Commit blocked: fix the errors above." >&2; exit 1; }
